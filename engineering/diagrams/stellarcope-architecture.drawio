        </mxCell>
        <mxCell id="p00-t-78" value="&lt;b&gt;Web path&lt;/b&gt;&lt;br&gt;Tracker, intake, queue, worker, Umami. Intake returns 202 only after the queue accepts the envelope." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="2034" width="840" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p00-m-79" value="2" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1000" y="2044" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p00-t-80" value="&lt;b&gt;API path&lt;/b&gt;&lt;br&gt;Collector drops traces, spans and logs. The private relay binds the tenant and normalizes routes." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1056" y="2034" width="840" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p00-m-81" value="3" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1960" y="2044" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p00-t-82" value="&lt;b&gt;Onchain path&lt;/b&gt;&lt;br&gt;Registered accounts and contracts are read from Horizon and Stellar RPC as daily counts." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="2016" y="2034" width="840" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p00-m-83" value="4" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="2162" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p00-t-84" value="&lt;b&gt;Daily seals&lt;/b&gt;&lt;br&gt;One Merkle root per day over every project summary, written to Stellar with manage_data." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="2152" width="840" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p00-m-85" value="5" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1000" y="2162" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p00-t-86" value="&lt;b&gt;Regional failover&lt;/b&gt;&lt;br&gt;If the primary region fails, DNS sends intake to the standby; workers drain it on recovery." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1056" y="2152" width="840" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p00-m-87" value="6" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1960" y="2162" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p00-t-88" value="&lt;b&gt;Access&lt;/b&gt;&lt;br&gt;Owners and operators sign in with SEP-10. Every read goes through the reporting API." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="2016" y="2152" width="840" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p00-t-89" value="Solid dark border = owner  ·  Dashed purple = standby failure domain  ·  Green = Stellar network  ·  Arrow color = sender role  ·  Arc = crossing, no connection" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
