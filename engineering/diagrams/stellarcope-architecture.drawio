        </mxCell>
        <mxCell id="p06-t-5" value="STELLARCOPE · control.tenants.status" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fontColor=#262626;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="162" width="457" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p06-t-6" value="Transitions are written with the actor and reason" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="48" y="196" width="451" height="30" as="geometry" />
