        <mxCell id="p06-edge-20" value="S5 suspended" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;strokeColor=#D6B656;endArrow=block;endFill=1;startArrow=none;startFill=0;dashed=0;exitX=1.0;exitY=0.2692;exitPerimeter=0;entryX=0.0;entryY=0.2692;entryPerimeter=0;fontFamily=Arial;fontSize=14;fontColor=#262626;labelBackgroundColor=#FFFFFF;spacing=4;" edge="1" parent="1" source="p06-c-9" target="p06-c-11">
