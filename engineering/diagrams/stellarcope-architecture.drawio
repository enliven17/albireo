        </mxCell>
        <mxCell id="p10-m-80" value="1" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1964" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p10-t-81" value="&lt;b&gt;Two accounts&lt;/b&gt;&lt;br&gt;A compromise of production credentials cannot delete the backup vault." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="1954" width="1240" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p10-m-82" value="2" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1964" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p10-t-83" value="&lt;b&gt;Three zones&lt;/b&gt;&lt;br&gt;Intake and workers run in every zone; RDS fails over to its synchronous standby." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1456" y="1954" width="1240" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p10-m-84" value="3" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="2054" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p10-t-85" value="&lt;b&gt;Serverless standby&lt;/b&gt;&lt;br&gt;Idle cost near zero; Route 53 moves intake there if the primary is unhealthy." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="2044" width="1240" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p10-m-86" value="4" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="2054" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p10-t-87" value="&lt;b&gt;Outside AWS&lt;/b&gt;&lt;br&gt;An EU copy, the status page and the uptime checks survive an AWS account problem." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1456" y="2044" width="1240" height="82" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
