        </mxCell>
        <mxCell id="p02-t-58" value="&lt;b&gt;Canonical identity&lt;/b&gt;&lt;br&gt;Tenant, service, instance, metric, attributes and time identify a point." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
