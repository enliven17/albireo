          <mxGeometry x="1200" y="1694" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p08-t-181" value="&lt;b&gt;Hashes only&lt;/b&gt;&lt;br&gt;Ingest credentials and API keys are stored as hashes; the secret is shown once." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
