        <mxCell id="p01-t-2" value="A web event is accepted only after durable publication. The worker writes receipt and effects in one transaction, so retries and redeliveries never double count." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#262626;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
