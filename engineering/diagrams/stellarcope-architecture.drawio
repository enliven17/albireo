        <mxCell id="p06-edge-19" value="S4 declined" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;strokeColor=#B85450;endArrow=block;endFill=1;startArrow=none;startFill=0;dashed=0;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;fontFamily=Arial;fontSize=14;fontColor=#262626;labelBackgroundColor=#FFFFFF;spacing=4;" edge="1" parent="1" source="p06-c-8" target="p06-c-10">
