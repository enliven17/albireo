        <mxCell id="p01-t-1" value="01 · Web event | admission to an exactly-once Umami write" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=30;fontColor=#262626;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
