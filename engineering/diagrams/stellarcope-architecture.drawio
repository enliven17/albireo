        <mxCell id="p06-edge-23" value="S8 removed" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;strokeColor=#B85450;endArrow=block;endFill=1;startArrow=none;startFill=0;dashed=0;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;fontFamily=Arial;fontSize=14;fontColor=#262626;labelBackgroundColor=#FFFFFF;spacing=4;" edge="1" parent="1" source="p06-c-11" target="p06-c-12">
          <mxGeometry relative="1" as="geometry" x="0.0" />
        </mxCell>
        <mxCell id="p06-edge-24" value="S9 erasure job" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;strokeColor=#595959;endArrow=block;endFill=1;startArrow=none;startFill=0;dashed=0;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;fontFamily=Arial;fontSize=14;fontColor=#262626;labelBackgroundColor=#FFFFFF;spacing=4;" edge="1" parent="1" source="p06-c-12" target="p06-c-13">
          <mxGeometry relative="1" as="geometry" x="0.0" />
        </mxCell>
        <mxCell id="p06-edge-25" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;strokeColor=#595959;endArrow=block;endFill=1;startArrow=none;startFill=0;dashed=0;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;fontFamily=Arial;fontSize=14;fontColor=#262626;labelBackgroundColor=#FFFFFF;spacing=4;" edge="1" parent="1" source="p06-c-13" target="p06-e-14">
          <mxGeometry relative="1" as="geometry" x="0.0" />
        </mxCell>
        <mxCell id="p06-edge-26" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;strokeColor=#B85450;endArrow=block;endFill=1;startArrow=none;startFill=0;dashed=0;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;fontFamily=Arial;fontSize=14;fontColor=#262626;labelBackgroundColor=#FFFFFF;spacing=4;" edge="1" parent="1" source="p06-c-10" target="p06-e-15">
          <mxGeometry relative="1" as="geometry" x="0.0" />
        </mxCell>
        <mxCell id="p06-m-27" value="1" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1374" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p06-t-28" value="&lt;b&gt;S1 / S2&lt;/b&gt;&lt;br&gt;Mode is a global setting changed only by operators; enrollment itself is one transaction." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="1364" width="920" height="78" as="geometry" />
        </mxCell>
        <mxCell id="p06-m-29" value="2" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1374" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p06-t-30" value="&lt;b&gt;S3 / S4&lt;/b&gt;&lt;br&gt;Operator decision recorded with actor and reason. Declined projects hold no data." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1136" y="1364" width="920" height="78" as="geometry" />
        </mxCell>
        <mxCell id="p06-m-31" value="3" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1460" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p06-t-32" value="&lt;b&gt;S5 / S6&lt;/b&gt;&lt;br&gt;Suspension rejects ingestion at admission within the registry window; data is kept." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="1450" width="920" height="78" as="geometry" />
        </mxCell>
        <mxCell id="p06-m-33" value="4" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1460" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p06-t-34" value="&lt;b&gt;S7 / S8&lt;/b&gt;&lt;br&gt;Tombstone first. It outranks queue replay and is reapplied after any restore." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1136" y="1450" width="920" height="78" as="geometry" />
        </mxCell>
        <mxCell id="p06-m-35" value="5" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1546" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p06-t-36" value="&lt;b&gt;S9&lt;/b&gt;&lt;br&gt;Erasure job deletes all project data; backups expire within 35 days." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="1536" width="920" height="78" as="geometry" />
        </mxCell>
        <mxCell id="p06-leg-37" value="Normal" style="rounded=1;arcSize=8;html=1;fontFamily=Arial;fontSize=15;fontColor=#262626;align=center;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1640" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p06-leg-38" value="Waiting or paused" style="rounded=1;arcSize=8;html=1;fontFamily=Arial;fontSize=15;fontColor=#262626;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="210" y="1640" width="201" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p06-leg-39" value="Removed or declined" style="rounded=1;arcSize=8;html=1;fontFamily=Arial;fontSize=15;fontColor=#262626;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="431" y="1640" width="220" height="40" as="geometry" />
