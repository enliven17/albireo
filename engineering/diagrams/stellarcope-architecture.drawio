          <mxGeometry x="780" y="2704" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p02-t-54" value="&lt;b&gt;Tenant from the credential&lt;/b&gt;&lt;br&gt;A tenant attribute sent by the caller is never trusted." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
