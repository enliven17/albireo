        </mxCell>
        <mxCell id="p02-t-56" value="&lt;b&gt;Partial publish&lt;/b&gt;&lt;br&gt;If any part fails, the SDK retries; published parts repeat safely." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
