        <mxCell id="p02-t-52" value="&lt;b&gt;Credential first&lt;/b&gt;&lt;br&gt;Unauthenticated data is rejected before any processing." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
