        </mxCell>
        <mxCell id="p12-t-50" value="&lt;b&gt;Erasure outlives restores&lt;/b&gt;&lt;br&gt;Tombstones are reapplied to any restored database before it serves traffic." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
