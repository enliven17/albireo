        <mxCell id="p05-m-46" value="4" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1708" y="378" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p05-m-47" value="5" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1678" y="1238" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p05-m-48" value="1" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="2084" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p05-t-49" value="&lt;b&gt;Authentication&lt;/b&gt;&lt;br&gt;SEP-10 sessions or operator-issued API keys, stored only as hashes." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="2074" width="660" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p05-m-50" value="2" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="820" y="2084" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p05-t-51" value="&lt;b&gt;Roles&lt;/b&gt;&lt;br&gt;Owners and members: own tenant. Operators: global aggregates. API keys: read metrics." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="876" y="2074" width="660" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p05-m-52" value="3" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1600" y="2084" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p05-t-53" value="&lt;b&gt;Row-level security&lt;/b&gt;&lt;br&gt;Tenant context is set per transaction, so pooled connections cannot leak it." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1656" y="2074" width="660" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p05-m-54" value="4" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="2180" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p05-t-55" value="&lt;b&gt;Bounded staleness&lt;/b&gt;&lt;br&gt;The suspension registry may be up to 60 minutes old; older, ingestion fails closed." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="2170" width="660" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p05-m-56" value="5" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="820" y="2180" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p05-t-57" value="&lt;b&gt;Trusted tenant&lt;/b&gt;&lt;br&gt;A tenant field in a payload is rejected; the tenant always comes from the server." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="876" y="2170" width="660" height="88" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
