        </mxCell>
        <mxCell id="p06-t-2" value="Enrollment is self-service unless SCF switches on approval mode. Removal writes a tombstone that outranks replay and restore; erasure then deletes the project's data." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#262626;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="74" width="2120" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p06-t-3" value="STELLARCOPE  |  ARCHITECTURE  ·  06 / 13" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=right;verticalAlign=middle;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
