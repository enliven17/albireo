        <mxCell id="p00-c-29" value="&lt;b&gt;SITE + TRACKER v2&lt;/b&gt;&lt;br&gt;Pinned URL with SRI hash&lt;br&gt;New event ID per action&lt;br&gt;Retry with the same ID&lt;br&gt;No cookies or local storage" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=17;fontColor=#262626;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#595959;strokeWidth=1.8;" vertex="1" parent="1">
