        <mxCell id="p09-t-2" value="Umami keeps its own pinned schema; Stellarcope adds only the receipt table beside it. Analytics tables derive from immutable points and daily counts; seals commit to the day's summaries." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#262626;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
