          <mxGeometry x="210" y="2200" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p03-leg-66" value="Revision" style="rounded=1;arcSize=8;html=1;fontFamily=Arial;fontSize=15;fontColor=#262626;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.8;" vertex="1" parent="1">
