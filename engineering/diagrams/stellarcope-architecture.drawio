        <mxCell id="p08-t-179" value="&lt;b&gt;Row-level security&lt;/b&gt;&lt;br&gt;Every tenant-scope table filters by the transaction&amp;#x27;s tenant context." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
