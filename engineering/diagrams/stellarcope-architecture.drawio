        </mxCell>
        <mxCell id="p12-t-2" value="Personal data exists only in memory during admission. What is stored cannot identify a visitor across days, retention is bounded, and erasure survives backups and restores." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#262626;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
