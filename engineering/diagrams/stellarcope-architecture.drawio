        <mxCell id="p01-t-63" value="&lt;b&gt;Exactly-once effects&lt;/b&gt;&lt;br&gt;The receipt key (tenant, site, eventId) and all effects commit together or not at all." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="836" y="1934" width="620" height="102" as="geometry" />
        </mxCell>
        <mxCell id="p01-m-64" value="3" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1520" y="1944" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p01-t-65" value="&lt;b&gt;Crash safety&lt;/b&gt;&lt;br&gt;A crash before delete causes redelivery. The receipt turns the replay into a no-op." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1576" y="1934" width="620" height="102" as="geometry" />
        </mxCell>
