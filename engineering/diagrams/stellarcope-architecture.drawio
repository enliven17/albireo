        </mxCell>
        <mxCell id="p12-t-48" value="&lt;b&gt;Smallest erasure set&lt;/b&gt;&lt;br&gt;No stored data identifies a visitor; erasure applies to tenants and enrolled people." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
