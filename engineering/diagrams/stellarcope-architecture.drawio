        <mxCell id="p10-edge-78" value="Encrypted copy" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;strokeColor=#777777;endArrow=block;endFill=1;startArrow=none;startFill=0;dashed=0;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;fontFamily=Arial;fontSize=14;fontColor=#262626;labelBackgroundColor=#FFFFFF;spacing=4;" edge="1" parent="1" source="p10-c-62" target="p10-c-65">
          <mxGeometry relative="1" as="geometry" x="0.0" />
        </mxCell>
        <mxCell id="p10-edge-79" value="Publish" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;strokeColor=#82B366;endArrow=block;endFill=1;startArrow=none;startFill=0;dashed=0;exitX=0.5;exitY=0.0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryPerimeter=0;fontFamily=Arial;fontSize=14;fontColor=#262626;labelBackgroundColor=#FFFFFF;spacing=4;" edge="1" parent="1" source="p10-c-67" target="p10-c-66">
