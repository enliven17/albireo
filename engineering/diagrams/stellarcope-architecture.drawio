        </mxCell>
        <mxCell id="p09-t-214" value="&lt;b&gt;Receipts beside Umami&lt;/b&gt;&lt;br&gt;Receipt and Umami effects commit in one transaction; receipts are kept 8 days." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="1724" width="1040" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p09-m-215" value="2" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1734" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p09-t-216" value="&lt;b&gt;Points before rollups&lt;/b&gt;&lt;br&gt;Raw points are kept 7 days; corrections replace a stream&amp;#x27;s contribution." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1256" y="1724" width="1040" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p09-m-217" value="3" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1830" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p09-t-218" value="&lt;b&gt;Counts, not addresses&lt;/b&gt;&lt;br&gt;Onchain tables hold daily totals; subjects live in the control schema." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="1820" width="1040" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p09-m-219" value="4" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1830" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p09-t-220" value="&lt;b&gt;Seal revisions&lt;/b&gt;&lt;br&gt;A later correction adds a revision; anchored roots are never rewritten." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1256" y="1820" width="1040" height="88" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
