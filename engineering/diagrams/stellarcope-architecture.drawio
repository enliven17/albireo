        </mxCell>
        <mxCell id="p06-c-9" value="&lt;b&gt;ACTIVE&lt;/b&gt;&lt;br&gt;Accepts data, visible to owner" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=19;fontColor=#262626;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=5;spacingBottom=5;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="300" y="600" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p06-c-10" value="&lt;b&gt;DECLINED&lt;/b&gt;&lt;br&gt;Never accepted data" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=19;fontColor=#262626;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=5;spacingBottom=5;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="940" y="260" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p06-c-11" value="&lt;b&gt;SUSPENDED&lt;/b&gt;&lt;br&gt;Ingestion rejected, data kept" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=19;fontColor=#262626;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=5;spacingBottom=5;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.8;" vertex="1" parent="1">
