          <mxGeometry x="40" y="1784" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p08-t-183" value="&lt;b&gt;Tombstones&lt;/b&gt;&lt;br&gt;One per removed tenant; checked before effects and reapplied after restores." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
