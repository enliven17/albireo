        </mxCell>
        <mxCell id="p12-t-46" value="&lt;b&gt;Truncation before lookup&lt;/b&gt;&lt;br&gt;Geolocation sees a truncated address and stores only the country." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
