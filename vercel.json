{
  "regions": ["iad1"],
  "crons": [{ "path": "/api/cron/seal", "schedule": "30 0 * * *" }],
  "redirects": [{ "source": "/p/albireo", "destination": "/p/stellarcope", "permanent": true }],
  "rewrites": [
    { "source": "/e", "destination": "/api/e" },
    { "source": "/((?!api/|t/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/t/(.*)", "headers": [
      { "key": "cache-control", "value": "public, max-age=31536000, immutable" },
      { "key": "access-control-allow-origin", "value": "*" },
      { "key": "cross-origin-resource-policy", "value": "cross-origin" }
    ] }
  ]
}
