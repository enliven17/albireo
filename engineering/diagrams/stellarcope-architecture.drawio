        <mxCell id="p03-m-53" value="5" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1668" y="1558" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p03-m-54" value="1" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1794" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p03-t-55" value="&lt;b&gt;Proof of control&lt;/b&gt;&lt;br&gt;A signature from the account itself, or a listing in the project&amp;#x27;s verified stellar.toml." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="1784" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p03-m-56" value="2" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="1794" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p03-t-57" value="&lt;b&gt;Counts only&lt;/b&gt;&lt;br&gt;No addresses of interacting accounts are stored, only daily totals." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="716" y="1784" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p03-m-58" value="3" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1912" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p03-t-59" value="&lt;b&gt;One root per day&lt;/b&gt;&lt;br&gt;Leaves are sorted by tenant so the tree is reproducible by anyone." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="1902" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p03-m-60" value="4" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="1912" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p03-t-61" value="&lt;b&gt;Corrections are explicit&lt;/b&gt;&lt;br&gt;Later data creates a revision with a new root; the earlier root stays." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="716" y="1902" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p03-m-62" value="5" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="2030" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p03-t-63" value="&lt;b&gt;What a seal proves&lt;/b&gt;&lt;br&gt;That a published summary was not changed after anchoring, not that every event was real." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="2020" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p03-leg-64" value="Tenant side" style="rounded=1;arcSize=8;html=1;fontFamily=Arial;fontSize=15;fontColor=#262626;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#595959;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="40" y="2200" width="150" height="40" as="geometry" />
        </mxCell>
