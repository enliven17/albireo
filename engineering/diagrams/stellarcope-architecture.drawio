        <mxCell id="p06-c-12" value="&lt;b&gt;REMOVED&lt;/b&gt;&lt;br&gt;Tombstone written, data hidden" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=19;fontColor=#262626;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=5;spacingBottom=5;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.8;" vertex="1" parent="1">
