          <mxGeometry x="110" y="538" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p06-c-8" value="&lt;b&gt;PENDING_APPROVAL&lt;/b&gt;&lt;br&gt;Approval mode only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=19;fontColor=#262626;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=5;spacingBottom=5;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.8;" vertex="1" parent="1">
