        <mxCell id="p08-t-185" value="&lt;b&gt;Settings&lt;/b&gt;&lt;br&gt;Holds the enrollment mode (self service or approval) and is operator-only." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
