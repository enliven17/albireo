        <mxCell id="p12-t-44" value="&lt;b&gt;Daily salt&lt;/b&gt;&lt;br&gt;Umami&amp;#x27;s resolver with SALT_ROTATION=day and a server secret; old salts are discarded." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
