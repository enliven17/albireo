        <mxCell id="p11-m-42" value="4" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1678" y="1078" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p11-m-43" value="1" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1904" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p11-t-44" value="&lt;b&gt;Region loss&lt;/b&gt;&lt;br&gt;Route 53 health checks move intake to the serverless standby; accepted events wait in its queue." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="1894" width="1040" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p11-m-45" value="2" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1904" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p11-t-46" value="&lt;b&gt;Registry outage&lt;/b&gt;&lt;br&gt;Admission continues for 60 minutes, then fails closed; revocations are reconciled." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1256" y="1894" width="1040" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p11-m-47" value="3" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="2000" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p11-t-48" value="&lt;b&gt;Queue fault&lt;/b&gt;&lt;br&gt;A retryable error with the same event ID delays data instead of losing it." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="1990" width="1040" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p11-m-49" value="4" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2000" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p11-t-50" value="&lt;b&gt;Measured, not assumed&lt;/b&gt;&lt;br&gt;Independent checks every minute; no maintenance exclusions; reported monthly." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1256" y="1990" width="1040" height="88" as="geometry" />
        </mxCell>
