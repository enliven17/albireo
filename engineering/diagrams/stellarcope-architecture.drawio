        </mxCell>
        <mxCell id="p07-edge-28" value="T9" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;strokeColor=#D79B00;endArrow=block;endFill=1;startArrow=none;startFill=0;dashed=0;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.8913;entryY=0.0;entryPerimeter=0;fontFamily=Arial;fontSize=14;fontColor=#262626;labelBackgroundColor=#FFFFFF;spacing=4;" edge="1" parent="1" source="p07-c-14" target="p07-c-15">
          <mxGeometry relative="1" as="geometry" x="0.0" />
        </mxCell>
        <mxCell id="p07-edge-29" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;strokeColor=#555555;endArrow=block;endFill=1;startArrow=none;startFill=0;dashed=0;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;fontFamily=Arial;fontSize=14;fontColor=#262626;labelBackgroundColor=#FFFFFF;spacing=4;" edge="1" parent="1" source="p07-c-15" target="p07-e-16">
          <mxGeometry relative="1" as="geometry" x="0.0" />
        </mxCell>
        <mxCell id="p07-m-30" value="1" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1454" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p07-t-31" value="&lt;b&gt;T2 / T3&lt;/b&gt;&lt;br&gt;A worker that crashes before deleting simply lets the message reappear." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="1444" width="960" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p07-m-32" value="2" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1454" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p07-t-33" value="&lt;b&gt;T4 / T5&lt;/b&gt;&lt;br&gt;The receipt decides: a new key commits effects, an existing key is a no-op." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1176" y="1444" width="960" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p07-m-34" value="3" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1536" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p07-t-35" value="&lt;b&gt;T6&lt;/b&gt;&lt;br&gt;Same identity with different content is quarantined, never counted." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="1526" width="960" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p07-m-36" value="4" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1536" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p07-t-37" value="&lt;b&gt;T7&lt;/b&gt;&lt;br&gt;Tombstones are checked before any effect, including after a restore." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1176" y="1526" width="960" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p07-m-38" value="5" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1618" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p07-t-39" value="&lt;b&gt;T8&lt;/b&gt;&lt;br&gt;After the receive limit the message moves to the dead letter queue, kept 14 days." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="1608" width="960" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p07-m-40" value="6" style="ellipse;html=1;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#262626;fillColor=#F5F5F5;strokeColor=#262626;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1618" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p07-t-41" value="&lt;b&gt;T9&lt;/b&gt;&lt;br&gt;Delete happens only after the outcome is durable." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#262626;fontStyle=0;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1176" y="1608" width="960" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p07-leg-42" value="In queue" style="rounded=1;arcSize=8;html=1;fontFamily=Arial;fontSize=15;fontColor=#262626;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1760" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p07-leg-43" value="Processing" style="rounded=1;arcSize=8;html=1;fontFamily=Arial;fontSize=15;fontColor=#262626;align=center;verticalAlign=middle;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="210" y="1760" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p07-leg-44" value="No effect" style="rounded=1;arcSize=8;html=1;fontFamily=Arial;fontSize=15;fontColor=#262626;align=center;verticalAlign=middle;fillColor=#F5F5F5;strokeColor=#595959;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="380" y="1760" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p07-leg-45" value="Failure" style="rounded=1;arcSize=8;html=1;fontFamily=Arial;fontSize=15;fontColor=#262626;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="550" y="1760" width="150" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="08 · Data model | control plane" id="stellarcope-08">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1980" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p08-t-1" value="08 · Data model | control plane" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=30;fontColor=#262626;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="22" width="2320" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p08-t-2" value="Tenant-scoped tables live under row-level security. Operator-scope tables hold no tenant data. Secrets are stored only as hashes." style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#262626;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fillColor=none;strokeColor=none;" vertex="1" parent="1">
